generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  REP
  MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum PriceRule {
  NONE
  PERCENT_OFF
}

enum OfferKind {
  UPSELL
  CROSS_SELL
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  STALE
}

enum CustomerStatus {
  DRAFT
  SENT
  NEGOTIATING
  CONFIRMED
}

enum FulfillmentStatus {
  NONE
  PLANNED
  PARTIAL
  FULFILLED
}

enum PaymentStatus {
  NONE
  UNPAID
  PARTIAL
  PAID
}

enum RequiredLevel {
  NONE
  MANAGER
  FINANCE
}

enum RevisionSource {
  REP
  PORTAL
  SYSTEM
}

enum ApprovalLevel {
  MANAGER
  FINANCE
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  STALE
}

enum AuditAction {
  QUOTE_CREATED
  LINE_ADDED
  LINE_UPDATED
  LINE_REMOVED
  ORDER_DISCOUNT_CHANGED
  SUBMITTED
  AUTO_APPROVED
  APPROVED
  RETURNED
  REJECTED
  REVISED
  UPSELL_ADDED
  UPSELL_DISMISSED
  CROSS_SELL_ADDED
  CROSS_SELL_DISMISSED
  SETTINGS_CHANGED
  PORTAL_MESSAGE
  COUNTER_PROPOSED
  SENT
  COUNTER_ACCEPTED
  CONFIRMED
  ORDER_CREATED
  INVOICE_ISSUED
  SUBSCRIPTION_CREATED
  SPLIT_ACCEPTED
  SPLIT_OVERRIDDEN
  STOCK_RECEIVED
  BACKORDER_CONSOLIDATED
  SHIPPED
  SUBSCRIPTION_MODIFIED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  BILLING_RUN
  REPLENISHMENT_SCHEDULED
  CREDIT_NOTE_ISSUED
  PAYMENT_RECORDED
  NUDGE_SENT
  ESCALATED
  ALERT_DISMISSED
  TASK_COMPLETED
  RESET
}

enum TaskKind {
  NUDGE
  ESCALATION
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum InvoiceKind {
  ONE_TIME
  RECURRING
  PRORATION
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CREDITED
}

enum BillingPeriodStatus {
  SCHEDULED
  INVOICED
  SKIPPED
}

model User {
  id               Int             @id @default(autoincrement())
  email            String          @unique
  passwordHash     String
  name             String
  role             UserRole        @default(REP)
  customerId       Int?
  customer         Customer?       @relation(fields: [customerId], references: [id])
  quotes           Quote[]         @relation("QuoteOwner")
  revisions        QuoteRevision[]
  approvalActions  ApprovalStep[]  @relation("ApprovalActor")
  auditEvents      AuditEvent[]
  recordedPayments Payment[]       @relation("PaymentRecorder")
  paymentSessions  PaymentSession[] @relation("PaymentSessionCreator")
  portalMessages   PortalMessage[]
  customerInvites  CustomerInvite[] @relation("CustomerInviteCreator")
  passwordResets   PasswordReset[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([customerId])
  @@index([role])
}

model Customer {
  id              Int          @id @default(autoincrement())
  name            String
  code            String       @unique
  tier            CustomerTier
  email           String
  phone           String       @default("")
  gstin           String       @default("")
  billingAddress  String       @default("")
  notes           String?
  users           User[]
  invites         CustomerInvite[]
  quotes          Quote[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tier])
}

model CustomerInvite {
  id          Int       @id @default(autoincrement())
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById Int
  createdBy   User      @relation("CustomerInviteCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([customerId, email])
  @@index([expiresAt])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id                 Int       @id @default(autoincrement())
  name               String    @unique
  discountCeilingBps Int
  products           Product[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SubscriptionPlan {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  interval       BillingInterval
  prorateChanges Boolean         @default(true)
  creditOnCancel Boolean         @default(false)
  products       Product[]
  subscriptions  Subscription[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Product {
  id             Int               @id @default(autoincrement())
  name           String
  sku            String            @unique
  categoryId     Int
  category       Category          @relation(fields: [categoryId], references: [id])
  unit           String
  taxBps         Int
  listPricePaise Int
  costPaise      Int
  description    String
  isSubscription Boolean           @default(false)
  planId         Int?
  plan           SubscriptionPlan? @relation(fields: [planId], references: [id])
  isPromoted     Boolean           @default(false)
  active         Boolean           @default(true)
  imageUrl       String?
  variants       ProductVariant[]
  stock          Stock[]
  receipts       StockReceipt[]
  quoteLines     QuoteLine[]
  orderLines     OrderLine[]
  sourcePairings ProductPairing[]  @relation("PairingSource")
  targetPairings ProductPairing[]  @relation("PairingTarget")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([categoryId])
  @@index([planId])
  @@index([active])
}

model ProductVariant {
  id              Int            @id @default(autoincrement())
  productId       Int
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeName   String
  attributeValue  String
  extraPricePaise Int            @default(0)
  stock           Stock[]
  receipts        StockReceipt[]
  quoteLines      QuoteLine[]
  orderLines      OrderLine[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([productId, attributeName, attributeValue])
  @@index([productId])
}

model PriceList {
  id        Int          @id @default(autoincrement())
  name      String
  tier      CustomerTier @unique
  currency  String       @default("INR")
  rule      PriceRule    @default(NONE)
  valueBps  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model DiscountPolicy {
  id                      Int      @id @default(1)
  tierCeilingBronzeBps    Int      @default(500)
  tierCeilingSilverBps    Int      @default(1000)
  tierCeilingGoldBps      Int      @default(1500)
  financeLineExcessBps    Int      @default(800)
  financeBlendedExcessBps Int      @default(300)
  financeExcessValuePaise Int      @default(500000)
  staleAfterDays          Int      @default(5)
  anomalyDeltaBps         Int      @default(500)
  upsellMarginFloorBps    Int      @default(2000)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CompanyProfile {
  id               Int      @id @default(1)
  legalName        String   @default("")
  tradingName      String   @default("DealFlow")
  tagline          String   @default("")
  email            String   @default("")
  phone            String   @default("")
  addressLine1     String   @default("")
  addressLine2     String   @default("")
  city             String   @default("")
  state            String   @default("")
  pincode          String   @default("")
  country          String   @default("India")
  gstin            String   @default("")
  pan              String   @default("")
  bankName         String   @default("")
  bankAccountName  String   @default("")
  bankAccountNo    String   @default("")
  bankIfsc         String   @default("")
  logoDataUrl      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Warehouse {
  id                      Int            @id @default(autoincrement())
  name                    String
  code                    String         @unique
  shippingCostWeightPaise Int
  replenishmentLeadDays   Int
  active                  Boolean        @default(true)
  stock                   Stock[]
  receipts                StockReceipt[]
  allocations             Allocation[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

model Stock {
  id            Int             @id @default(autoincrement())
  warehouseId   Int
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  productId     Int
  product       Product         @relation(fields: [productId], references: [id])
  variantId     Int?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  onHand        Int
  reserved      Int             @default(0)
  reorderPoint  Int             @default(0)
  reorderQty    Int             @default(0)
  maxOnHand     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
}

model StockReceipt {
  id          Int             @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  productId   Int
  product     Product         @relation(fields: [productId], references: [id])
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  qty         Int
  expectedAt  DateTime
  receivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
}

model ProductPairing {
  id                 Int       @id @default(autoincrement())
  productId          Int
  product            Product   @relation("PairingSource", fields: [productId], references: [id], onDelete: Cascade)
  suggestedProductId Int
  suggestedProduct   Product   @relation("PairingTarget", fields: [suggestedProductId], references: [id], onDelete: Cascade)
  kind               OfferKind
  weight             Int
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([productId, suggestedProductId])
  @@index([productId])
  @@index([suggestedProductId])
  @@index([kind])
}

model Quote {
  id                   Int               @id @default(autoincrement())
  code                 String            @unique
  customerId           Int
  customer             Customer          @relation(fields: [customerId], references: [id])
  ownerId              Int
  owner                User              @relation("QuoteOwner", fields: [ownerId], references: [id])
  currentRevisionId    Int?              @unique
  currentRevision      QuoteRevision?    @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions            QuoteRevision[]   @relation("QuoteRevisions")
  approvalStatus       ApprovalStatus    @default(NONE)
  customerStatus       CustomerStatus    @default(DRAFT)
  fulfillmentStatus    FulfillmentStatus @default(NONE)
  paymentStatus        PaymentStatus     @default(NONE)
  lastActivityAt       DateTime          @default(now())
  promisedDeliveryDate DateTime?
  messages             PortalMessage[]
  auditEvents          AuditEvent[]
  orders               Order[]
  tasks                Task[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([customerId])
  @@index([ownerId])
  @@index([approvalStatus])
  @@index([customerStatus])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@index([lastActivityAt])
}

model Task {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  assigneeId  Int
  assignee    User     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById Int
  createdBy   User     @relation("TaskCreator", fields: [createdById], references: [id])
  kind        TaskKind
  message     String
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([assigneeId, done])
  @@index([createdById])
}

model QuoteRevision {
  id                 Int             @id @default(autoincrement())
  quoteId            Int
  quote              Quote           @relation("QuoteRevisions", fields: [quoteId], references: [id], onDelete: Cascade)
  currentForQuote    Quote?          @relation("CurrentRevision")
  version            Int
  orderDiscountBps   Int             @default(0)
  subtotalPaise      Int             @default(0)
  discountPaise      Int             @default(0)
  taxPaise           Int             @default(0)
  totalPaise         Int             @default(0)
  costPaise          Int             @default(0)
  marginPaise        Int             @default(0)
  marginBps          Int             @default(0)
  maxLineExcessBps   Int             @default(0)
  blendedExcessBps   Int             @default(0)
  excessValuePaise   Int             @default(0)
  requiredLevel      RequiredLevel   @default(NONE)
  reasons            Json            @default("[]")
  dismissedUpsellIds Json            @default("[]")
  createdById        Int
  createdBy          User            @relation(fields: [createdById], references: [id])
  createdVia         RevisionSource  @default(REP)
  submittedAt        DateTime?
  lines              QuoteLine[]
  approvalSteps      ApprovalStep[]
  portalMessages     PortalMessage[]
  orders             Order[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([quoteId, version])
  @@index([quoteId])
  @@index([createdById])
}

model QuoteLine {
  id                   Int             @id @default(autoincrement())
  revisionId           Int
  revision             QuoteRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  productId            Int
  product              Product         @relation(fields: [productId], references: [id])
  variantId            Int?
  variant              ProductVariant? @relation(fields: [variantId], references: [id])
  description          String
  qty                  Int
  unitPricePaise       Int
  unitCostPaise        Int
  lineDiscountBps      Int             @default(0)
  effectiveDiscountBps Int             @default(0)
  allowedDiscountBps   Int             @default(0)
  excessBps            Int             @default(0)
  netPaise             Int             @default(0)
  taxPaise             Int             @default(0)
  orderLines           OrderLine[]
  portalMessages       PortalMessage[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([revisionId])
  @@index([productId])
  @@index([variantId])
}

model ApprovalStep {
  id         Int                @id @default(autoincrement())
  revisionId Int
  revision   QuoteRevision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  level      ApprovalLevel
  sequence   Int
  status     ApprovalStepStatus @default(PENDING)
  actorId    Int?
  actor      User?              @relation("ApprovalActor", fields: [actorId], references: [id])
  actedAt    DateTime?
  reason     String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([revisionId, sequence])
  @@index([revisionId])
  @@index([actorId])
  @@index([level, status])
}

model PortalMessage {
  id                  Int           @id @default(autoincrement())
  quoteId             Int
  quote               Quote         @relation(fields: [quoteId], references: [id])
  revisionId          Int
  revision            QuoteRevision @relation(fields: [revisionId], references: [id])
  customerUserId      Int
  customerUser        User          @relation(fields: [customerUserId], references: [id])
  lineId              Int?
  line                QuoteLine?    @relation(fields: [lineId], references: [id])
  message             String
  proposedDiscountBps Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([quoteId])
  @@index([revisionId])
  @@index([customerUserId])
  @@index([lineId])
}

model AuditEvent {
  id        Int         @id @default(autoincrement())
  entity    String
  entityId  Int
  quoteId   Int?
  quote     Quote?      @relation(fields: [quoteId], references: [id])
  action    AuditAction
  actorId   Int?
  actor     User?       @relation(fields: [actorId], references: [id])
  reason    String?
  meta      Json        @default("{}")
  at        DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([quoteId, at])
  @@index([actorId])
  @@index([entity, entityId])
}

model Order {
  id                   Int            @id @default(autoincrement())
  code                 String         @unique
  quoteId              Int
  quote                Quote          @relation(fields: [quoteId], references: [id])
  revisionId           Int
  revision             QuoteRevision  @relation(fields: [revisionId], references: [id])
  confirmedAt          DateTime
  promisedDeliveryDate DateTime?
  lines                OrderLine[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([quoteId])
  @@index([revisionId])
}

model OrderLine {
  id             Int             @id @default(autoincrement())
  orderId        Int
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteLineId    Int
  quoteLine      QuoteLine       @relation(fields: [quoteLineId], references: [id])
  productId      Int
  product        Product         @relation(fields: [productId], references: [id])
  variantId      Int?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  qty            Int
  unitPricePaise Int
  allocations    Allocation[]
  backorders     Backorder[]
  subscriptions  Subscription[]
  invoiceLines   InvoiceLine[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orderId])
  @@index([quoteLineId])
  @@index([productId])
  @@index([variantId])
}

model Allocation {
  id          Int       @id @default(autoincrement())
  orderLineId Int
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  qty         Int
  reserved    Boolean   @default(false)
  reason      String
  shippedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderLineId])
  @@index([warehouseId])
}

model Backorder {
  id             Int       @id @default(autoincrement())
  orderLineId    Int
  orderLine      OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  qty            Int
  expectedAt     DateTime?
  consolidatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderLineId])
}

model Subscription {
  id             Int                  @id @default(autoincrement())
  orderId        Int
  order          Order                @relation(fields: [orderId], references: [id])
  orderLineId    Int
  orderLine      OrderLine            @relation(fields: [orderLineId], references: [id])
  planId         Int
  plan           SubscriptionPlan     @relation(fields: [planId], references: [id])
  qty            Int
  unitPricePaise Int
  startsAt       DateTime
  nextBillingAt  DateTime
  pausedAt       DateTime?
  status         SubscriptionStatus   @default(ACTIVE)
  changes        SubscriptionChange[]
  billingPeriods BillingPeriod[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([orderId])
  @@index([orderLineId])
  @@index([planId])
}

model SubscriptionChange {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  effectiveAt    DateTime
  qtyDelta       Int
  prorationPaise Int
  reason         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([subscriptionId])
}

model BillingPeriod {
  id             Int                 @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  qty            Int
  unitPricePaise Int
  amountPaise    Int
  taxPaise       Int
  status         BillingPeriodStatus @default(SCHEDULED)
  invoiceId      Int?
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([status])
}

model Invoice {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  orderId     Int
  order       Order         @relation(fields: [orderId], references: [id])
  kind        InvoiceKind
  periodStart DateTime?
  periodEnd   DateTime?
  totalPaise  Int
  paidPaise   Int           @default(0)
  status      InvoiceStatus @default(UNPAID)
  issuedAt    DateTime
  dueAt       DateTime
  lines            InvoiceLine[]
  payments         Payment[]
  paymentSessions  PaymentSession[]
  creditNotes      CreditNote[]
  billingPeriods   BillingPeriod[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

model InvoiceLine {
  id          Int        @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderLineId Int?
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id])
  description String
  qty         Int
  unitPaise   Int
  taxPaise    Int
  totalPaise  Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([invoiceId])
  @@index([orderLineId])
}

model Payment {
  id           Int      @id @default(autoincrement())
  invoiceId    Int
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  amountPaise  Int
  reference    String   @unique
  method       String
  receivedAt   DateTime
  recordedById Int
  recordedBy   User     @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([invoiceId])
  @@index([recordedById])
}

model PaymentSession {
  id                Int      @id @default(autoincrement())
  invoiceId         Int
  invoice           Invoice  @relation(fields: [invoiceId], references: [id])
  orderId           String   @unique
  cfOrderId         String?
  paymentSessionId  String
  amountPaise       Int
  status            String
  createdById       Int
  createdBy         User     @relation("PaymentSessionCreator", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([invoiceId])
  @@index([createdById])
  @@index([status])
}

model CreditNote {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amountPaise Int
  reason      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}
